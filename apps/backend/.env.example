PORT=5000
NODE_ENV=development
 MONGODB_URI=mongodb://127.0.0.1:27017/healthcare-resource-manager
# Frontend origin(s) allowed by CORS - comma-separated for multiple (e.g. a
# deployed origin plus a local dev origin). Cookie auth requires the request's
# Origin to match one of these exactly; unset allows any origin (dev only -
# never in prod).
CLIENT_URL=http://localhost:5173
ACCESS_TOKEN_SECRET=replace-with-long-random-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace-with-long-random-secret
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_MAX_AGE=900000
REFRESH_TOKEN_MAX_AGE=604800000

# Optional: set both to seed an admin account with a known password.
# Leave ADMIN_PASSWORD unset to have one generated and logged once at
# startup (the account is then locked to the change-password flow until
# it is rotated). Leave ADMIN_EMAIL unset to skip seeding entirely.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Admin
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

REQUEST_BODY_SIZE_LIMIT=10mb
MAX_UPLOAD_SIZE_BYTES=5242880
DOCTOR_MAX_UPLOAD_FILES=11
DRIVER_MAX_UPLOAD_FILES=11
VEHICLE_MAX_UPLOAD_FILES=20
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp
ALLOWED_DOCUMENT_MIME_TYPES=application/pdf

# File storage provider: LOCAL
FILE_STORAGE_PROVIDER=LOCAL

# Local storage
LOCAL_STORAGE_ROOT=uploads
FILE_PUBLIC_BASE_URL=/uploads
