PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/healthcare-resource-manager
CLIENT_URL=http://localhost:3000
ACCESS_TOKEN_SECRET=replace-with-long-random-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace-with-long-random-secret
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_MAX_AGE=900000
REFRESH_TOKEN_MAX_AGE=604800000
ADMIN_EMAIL=admin@healthcare.local
ADMIN_PASSWORD=Admin@123
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Admin
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

REQUEST_BODY_SIZE_LIMIT=10mb
MAX_UPLOAD_SIZE_BYTES=5242880
DOCTOR_MAX_UPLOAD_FILES=11
DRIVER_MAX_UPLOAD_FILES=11
VEHICLE_MAX_UPLOAD_FILES=20
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp
ALLOWED_DOCUMENT_MIME_TYPES=application/pdf

# File storage provider: LOCAL
FILE_STORAGE_PROVIDER=LOCAL

# Local storage
LOCAL_STORAGE_ROOT=uploads
FILE_PUBLIC_BASE_URL=/uploads
