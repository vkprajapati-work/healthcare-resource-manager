{
  "name": "@healthcare-resource-manager/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\""
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.0.0",
    "express-rate-limit": "^7.0.0",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.10.0",
    "winston": "^3.4.0",
    "xss-clean": "^0.1.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.5",
    "@types/express": "^5.0.1",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.1",
    "@typescript-eslint/eslint-plugin": "^8.14.1",
    "@typescript-eslint/parser": "^8.14.1",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.7.2"
  }
}
